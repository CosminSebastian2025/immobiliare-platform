{
  "name": "immobiliare-platform",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "postinstall": "prisma skills sync || exit 0",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:ui": "vitest --ui",
    "test:coverage": "vitest run --coverage",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui",
    "test:all": "npm run test && npm run test:e2e",
    "test:ci": "npm run test:coverage && npm run test:e2e",
    "db:sync": "tsx scripts/sync-databases.ts",
    "db:sync:neon": "tsx scripts/sync-neon.ts",
    "db:sync:mysql": "tsx scripts/sync-mysql.ts",
    "db:backup": "tsx scripts/backup-databases.ts",
    "db:prisma:generate": "prisma generate --schema=prisma/schema.prisma && prisma generate --schema=prisma/schema-neon.prisma && prisma generate --schema=prisma/schema-mysql.prisma && prisma generate --schema=prisma/schema-sqlite.prisma"
  },
  "dependencies": {
    "@auth/prisma-adapter": "^2.11.3",
    "@next/third-parties": "^16.4.0",
    "@prisma/client": "^7.10.0",
    "@radix-ui/react-dialog": "^1.2.0",
    "@radix-ui/react-dropdown-menu": "^2.1.25",
    "@radix-ui/react-select": "^2.3.8",
    "@radix-ui/react-tabs": "^1.1.22",
    "@radix-ui/react-toast": "^1.2.24",
    "@sendgrid/mail": "^8.1.6",
    "@sentry/nextjs": "^11.7.0",
    "@stripe/react-stripe-js": "^7.0.0",
    "@stripe/stripe-js": "^10.0.0",
    "@uploadthing/react": "^7.3.3",
    "@vercel/analytics": "^2.0.1",
    "@vercel/speed-insights": "^2.0.0",
    "bcryptjs": "^3.0.3",
    "clsx": "^2.1.1",
    "date-fns": "^4.4.0",
    "leaflet": "^1.9.4",
    "lucide-react": "^1.53.0",
    "next": "16.4.0",
    "next-auth": "^4.24.15",
    "nodemailer": "^7.0.13",
    "openai": "^7.32.0",
    "prisma": "^8.0.0-rc.22",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-leaflet": "^5.0.0",
    "recharts": "^3.10.1",
    "stripe": "^23.0.0",
    "tailwind-merge": "^3.7.0",
    "uploadthing": "^7.7.4",
    "vite": "^8.3.4",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@playwright/test": "^1.64.0",
    "@tailwindcss/turbopack": "^4",
    "@types/bcryptjs": "^2.4.6",
    "@types/leaflet": "^1.9.22",
    "@types/node": "^20",
    "@types/nodemailer": "^8.0.2",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "babel-plugin-react-compiler": "1.0.0",
    "eslint": "^9",
    "eslint-config-next": "16.4.0",
    "tailwindcss": "^4",
    "tsx": "^4.23.15",
    "typescript": "^5"
  }
}
